  "info": {
    "title": "Folio API",
    "description": "First-year accounting learning platform API.\n\n**Contract version:** 1.1.0 (A3 freeze).\nBreaking changes require a version bump and changelog note.\nAuth: HTTP-only cookie `folio_session`. Enrolment: university email.",
    "version": "1.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "courses",
      "description": ""
    },
    {
      "name": "enrolments",
      "description": ""
    },
    {
      "name": "topics",
      "description": ""
    },
    {
      "name": "materials",
      "description": ""
    },
    {
      "name": "questions",
      "description": ""
    },
    {
      "name": "attempts",
      "description": ""
    },
    {
      "name": "progress",
      "description": ""
    },
    {
      "name": "tutor",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "folio_session"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada.lovelace@example.ac.uk"
          },
          "displayName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "displayName",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada.lovelace@example.ac.uk"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada.lovelace@example.ac.uk"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CreateCourseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ACC101"
          },
          "title": {
            "type": "string",
            "example": "Introduction to Financial Accounting"
          },
          "term": {
            "type": "string",
            "example": "2026-T1"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "term"
        ]
      },
      "UpdateCourseDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          }
        }
      },
      "JoinCourseDto": {
        "type": "object",
        "properties": {
          "joinCode": {
            "type": "string",
            "example": "a1b2c3d4",
            "description": "Course join code"
          }
        },
        "required": [
          "joinCode"
        ]
      },
      "CsvImportPreviewDto": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "description": "CSV text: email,role (role optional, default student)",
            "example": "student1@example.ac.uk,student\nstudent2@example.ac.uk,student"
          }
        },
        "required": [
          "csv"
        ]
      },
      "CsvImportCommitDto": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "description": "CSV text: email,role (role optional, default student)",
            "example": "student1@example.ac.uk,student\nstudent2@example.ac.uk,student"
          },
          "confirm": {
            "type": "boolean",
            "description": "Must be true to commit after preview",
            "example": true
          }
        },
        "required": [
          "csv"
        ]
      },
      "OutcomeDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          }
        },
        "required": [
          "description"
        ]
      },
      "CreateTopicDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Double-entry basics"
          },
          "sequence": {
            "type": "number",
            "example": 1
          },
          "description": {
            "type": "string"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutcomeDto"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "CreateMaterialDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "slides",
              "video_link",
              "text_summary"
            ]
          },
          "source": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "externalUrl": {
            "type": "string",
            "description": "Required for video_link / optional text"
          },
          "body": {
            "type": "string",
            "description": "Inline text for text_summary"
          }
        },
        "required": [
          "title",
          "type"
        ]
      },
      "AskTutorDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "questionId": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "PreviewTutorDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "materialIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "message"
        ]
      },
      "McqOptionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "JournalLineDto": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ]
          },
          "amount": {
            "type": "string",
            "example": "100.00"
          }
        },
        "required": [
          "account",
          "direction",
          "amount"
        ]
      },
      "CreateQuestionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "mcq",
              "numerical",
              "journal"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "intro",
              "core",
              "stretch"
            ]
          },
          "marks": {
            "type": "string",
            "example": "1.00"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/McqOptionDto"
            }
          },
          "mcqCorrectOptionId": {
            "type": "string",
            "description": "MCQ correct option id"
          },
          "numericalValue": {
            "type": "string",
            "example": "250.00"
          },
          "numericalTolerance": {
            "type": "string",
            "example": "0.01"
          },
          "journalLines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JournalLineDto"
            }
          },
          "alternateAccounts": {
            "type": "object",
            "description": "Canonical account → alternate labels",
            "example": {
              "Cash": [
                "Bank",
                "Cash at bank"
              ]
            }
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "misconceptionTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "prompt"
        ]
      },
      "QuestionCsvDto": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean"
          }
        },
        "required": [
          "csv"
        ]
      },
      "SubmitAttemptDto": {
        "type": "object",
        "properties": {
          "selectedOptionId": {
            "type": "string",
            "description": "MCQ selected option id"
          },
          "value": {
            "type": "string",
            "description": "Numerical answer"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JournalLineDto"
            }
          }
        }
      }
    }
  }
}