# Root reference for local Docker data plane (copy values into server/.env)

# Postgres (docker-compose)
DATABASE_URL=postgresql://folio:folio@localhost:5432/folio

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible) — optional profile: docker-compose --profile storage up
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=folio
S3_SECRET_KEY=folio-minio-secret
S3_BUCKET=folio-materials
S3_REGION=us-east-1

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-in-local-dev
UNI_EMAIL_DOMAINS=example.ac.uk,ac.uk

# Server
PORT=3001
NODE_ENV=development

# Logging (server + client)
# Server: trace|debug|info|warn|error|fatal — default debug (dev) / info (prod)
LOG_LEVEL=debug
# Pretty multi-line Nest logs locally; set false in containers for JSON lines
LOG_PRETTY=true
LOG_SERVICE=folio-api
# Client (Next): debug|info|warn|error — default debug (dev) / warn (prod)
NEXT_PUBLIC_LOG_LEVEL=debug

# CORS (A3): comma-separated exact origins; Vercel preview hosts optional
CLIENT_ORIGIN=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=true

# Rate limits (Redis-backed when REDIS_URL is reachable)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=20
